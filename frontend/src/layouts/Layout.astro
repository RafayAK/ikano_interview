---
import "../styles/global.css";

interface Props {
  title?: string;
}

const { title = "Ikano Onboarding" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-900">
    <header class="border-b border-slate-200 bg-white">
      <div class="mx-auto flex max-w-2xl items-center justify-between px-4 py-4">
        <a href="/" class="text-lg font-semibold">Ikano Onboarding</a>
        <button
          id="clear-session"
          type="button"
          class="rounded-md border border-slate-300 px-2 py-1 text-xs text-slate-500 hover:bg-slate-50"
          title="Dev only: clears the resume cookie without touching the application"
        >
          Clear session
        </button>
      </div>
    </header>
    <main class="mx-auto max-w-2xl px-4 py-8">
      <slot />
    </main>
  </body>
</html>

<script>
  import { clearResume } from "../lib/api.js";

  document.querySelector("#clear-session")?.addEventListener("click", async () => {
    await clearResume().catch(() => {});
    window.location.href = "/";
  });
</script>
